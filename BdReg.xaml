<Window x:Class="Diplom.BdReg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Diplom"
        mc:Ignorable="d"
        Title="База данных"
        Height="350"
        Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Background="White" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Текущий путь"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <Border Grid.Row="1"
                Grid.RowSpan="2"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="5"
                Padding="15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Route"
                           VerticalAlignment="Center"
                           FontWeight="Bold"/>

                <ComboBox x:Name="ComboBoxRoute"
                          Grid.Row="0"
                          Grid.Column="1"
                          Height="28"
                          DisplayMemberPath="code"
                          SelectedValuePath="id"
                          SelectionChanged="ComboBoxRoute_SelectionChanged"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Direction"
                           VerticalAlignment="Center"
                           FontWeight="Bold"/>

                <ComboBox x:Name="ComboBoxDirection"
                          Grid.Row="2"
                          Grid.Column="1"
                          Height="28"
                          DisplayMemberPath="direction_type"
                          SelectedValuePath="id"
                          SelectionChanged="ComboBoxDirection_SelectionChanged"/>

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Picket"
                           VerticalAlignment="Center"
                           FontWeight="Bold"/>

                <ComboBox x:Name="ComboBoxPicket"
                          Grid.Row="4"
                          Grid.Column="1"
                          Height="28"
                          DisplayMemberPath="picket_number"
                          SelectedValuePath="id"
                          SelectionChanged="ComboBoxPicket_SelectionChanged"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">
            <Button x:Name="ButtonCreate"
                    Content="Создать"
                    Width="120"
                    Height="35"
                    Click="ButtonCreate_Click"/>
        </StackPanel>
    </Grid>
</Window>