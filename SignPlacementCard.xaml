<UserControl x:Class="Diplom.SignPlacementCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="#0B1320"
            BorderBrush="#1C2A41"
            BorderThickness="1"
            CornerRadius="16"
            Padding="14"
            Margin="0,0,0,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="72"
                    Height="72"
                    Background="#09111D"
                    BorderBrush="#28496F"
                    BorderThickness="1"
                    CornerRadius="12"
                    VerticalAlignment="Top">
                <Grid>
                    <Image Source="{Binding ImageSource, ElementName=Root}"
                           Stretch="UniformToFill"/>
                    <TextBlock Text="IMG"
                               Foreground="#355176"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ImageSource, ElementName=Root}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="{Binding Title, ElementName=Root}"
                               Foreground="#F3F7FF"
                               FontWeight="SemiBold"
                               FontSize="14"
                               VerticalAlignment="Center"/>

                    <Border DockPanel.Dock="Right"
                            CornerRadius="10"
                            Padding="10,5"
                            Margin="10,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#12253E"/>
                                <Setter Property="BorderBrush" Value="#31557F"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="SAVED">
                                        <Setter Property="Background" Value="#102A1A"/>
                                        <Setter Property="BorderBrush" Value="#1E6A3E"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="PENDING">
                                        <Setter Property="Background" Value="#2A2110"/>
                                        <Setter Property="BorderBrush" Value="#9A6710"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="READY">
                                        <Setter Property="Background" Value="#12253E"/>
                                        <Setter Property="BorderBrush" Value="#31557F"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock Text="{Binding Status, ElementName=Root}"
                                   FontWeight="Bold"
                                   FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#96CAFF"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="SAVED">
                                            <Setter Property="Foreground" Value="#52DF8A"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="PENDING">
                                            <Setter Property="Foreground" Value="#F5C66A"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="READY">
                                            <Setter Property="Foreground" Value="#96CAFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </DockPanel>

                <TextBlock Text="{Binding Line1, ElementName=Root}"
                           Foreground="#8BA3C7"
                           FontSize="12"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>

                <TextBlock Text="{Binding Line2, ElementName=Root}"
                           Foreground="#8BA3C7"
                           FontSize="12"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>

                <TextBlock Text="{Binding Line3, ElementName=Root}"
                           Foreground="#8BA3C7"
                           FontSize="12"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
