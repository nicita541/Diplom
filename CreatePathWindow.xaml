<Window x:Class="Diplom.CreatePathWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создать путь"
        Height="260"
        Width="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="Route"
                   VerticalAlignment="Center"
                   FontWeight="Bold"/>

        <TextBox x:Name="TextBoxRoute"
                 Grid.Row="0"
                 Grid.Column="1"
                 Height="28"/>

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="Direction"
                   VerticalAlignment="Center"
                   FontWeight="Bold"/>

        <TextBox x:Name="TextBoxDirection"
                 Grid.Row="2"
                 Grid.Column="1"
                 Height="28"/>

        <TextBlock Grid.Row="4"
                   Grid.Column="0"
                   Text="Picket"
                   VerticalAlignment="Center"
                   FontWeight="Bold"/>

        <TextBox x:Name="TextBoxPicket"
                 Grid.Row="4"
                 Grid.Column="1"
                 Height="28"/>

        <StackPanel Grid.Row="6"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Сохранить"
                    Width="100"
                    Height="32"
                    Margin="0,0,10,0"
                    Click="ButtonSave_Click"/>

            <Button Content="Отмена"
                    Width="100"
                    Height="32"
                    Click="ButtonCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>