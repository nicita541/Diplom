<Window x:Class="Diplom.AiVideoProcessingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Diplom"
        mc:Ignorable="d"
        Title="Обработка дорожных знаков"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#09101A"
        MinWidth="1360"
        MinHeight="820">

    <Window.Resources>
        <LinearGradientBrush x:Key="AppBgBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#09101A" Offset="0"/>
            <GradientStop Color="#0D1522" Offset="0.5"/>
            <GradientStop Color="#111A2A" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="RouteComboBoxToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="BorderBrush" Value="#23324B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                          Margin="16,0,0,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>

                                <Path Grid.Column="1"
                              Width="10"
                              Height="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="#8FA7CB"
                              Data="M 0 0 L 10 0 L 5 6 Z"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#39557D"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#67B2FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RouteComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="BorderBrush" Value="#23324B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                  Style="{StaticResource RouteComboBoxToggleStyle}"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  ClickMode="Press">
                                <TextBlock Text="{TemplateBinding SelectionBoxItem}"
                                   Foreground="{TemplateBinding Foreground}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="16,0,0,0"/>
                            </ToggleButton>

                            <Popup x:Name="Popup"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           Focusable="False"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           PopupAnimation="Slide">
                                <Border Margin="0,6,0,0"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                Background="#0F1727"
                                BorderBrush="#23324B"
                                BorderThickness="1"
                                CornerRadius="14">
                                    <ScrollViewer Margin="4"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#F8FAFC"/>
                        <Setter Property="Background" Value="#0F1727"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#16203B"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#243A6B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="ShellCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0F1725"/>
            <Setter Property="BorderBrush" Value="#1F2C43"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#0C1320"/>
            <Setter Property="BorderBrush" Value="#1A2638"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="MetricPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#101A2A"/>
            <Setter Property="BorderBrush" Value="#23314A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8EA0BF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Foreground" Value="#F3F7FF"/>
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="BorderBrush" Value="#23324B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#39557D"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#67B2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PathTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
            <Setter Property="Padding" Value="16,0,50,0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="InlineIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#16233A"/>
            <Setter Property="BorderBrush" Value="#2A3A66"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#DCE7FF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1B2C47"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3C5788"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#142238"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#5CA8FF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#76B7FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#4695ED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Foreground" Value="#D9E4F7"/>
            <Setter Property="Background" Value="#101A2A"/>
            <Setter Property="BorderBrush" Value="#24334D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#152134"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#39557D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1A2740"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlacementCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0B1320"/>
            <Setter Property="BorderBrush" Value="#1C2A41"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="460"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="26,26,18,26"
                Style="{StaticResource ShellCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,20">
                    <Border Width="46"
                            Height="46"
                            CornerRadius="14"
                            Background="#12253E"
                            HorizontalAlignment="Left">
                        <TextBlock Text="AI"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Обработка дорожных знаков"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,20,0,8"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Загрузка видео, извлечение кадров, поиск знаков и автоматическая запись результатов в базу данных."
                               Foreground="#869AB9"
                               FontSize="14"
                               TextWrapping="Wrap"
                               LineHeight="22"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True"
                              PanningMode="VerticalOnly">
                    <StackPanel>
                        <TextBlock Text="Источник видео" Style="{StaticResource InputLabelStyle}"/>
                        <ComboBox Style="{StaticResource RouteComboBoxStyle}" SelectedIndex="0">
                            <ComboBoxItem Content="Локальный MP4 файл"/>
                        </ComboBox>

                        <TextBlock Text="Путь к файлу" Style="{StaticResource InputLabelStyle}"/>
                        <Grid Margin="0,0,0,18">
                            <TextBox x:Name="Path_tbx" Text="D:\Video\route_session_07.mp4"
                                     Style="{StaticResource PathTextBoxStyle}"/>

                            <Button Content="..."
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"
                                    Click="Parh_New_Button_Click"
                                    Style="{StaticResource InlineIconButtonStyle}"/>
                        </Grid>

                        <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Куда сохранять"
                   Foreground="#E5EEFC"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0,0,0,14"/>

                                <TextBlock Text="Маршрут" Style="{StaticResource InputLabelStyle}"/>
                                <ComboBox x:Name="RouteComboBox"
                                          Style="{StaticResource RouteComboBoxStyle}"
                                          SelectionChanged="RouteComboBox_SelectionChanged">
                                </ComboBox>

                                <TextBlock Text="Направление" Style="{StaticResource InputLabelStyle}"/>
                                <ComboBox x:Name="DirectionComboBox"
                                          Style="{StaticResource RouteComboBoxStyle}"
                                          SelectionChanged="DirectionComboBox_SelectionChanged">
                                </ComboBox>

                                <TextBlock Text="Пикет" Style="{StaticResource InputLabelStyle}"/>
                                <ComboBox x:Name="PicketComboBox"
                                          Style="{StaticResource RouteComboBoxStyle}"
                                          SelectionChanged="PicketComboBox_SelectionChanged">
                                </ComboBox>
                            </StackPanel>
                        </Border>


                        <Button Content="Извлечь кадры"
                                Style="{StaticResource GhostButtonStyle}"
                                Margin="0,0,0,12"/>

                        <Button Content="Запустить полный анализ"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,0,10"
                                Click="Start_Analiz_Button_Click"/>

                        <Button Content="Остановить процесс"
                                Style="{StaticResource GhostButtonStyle}"
                                Margin="0,0,0,10"
                                Click="Stop_Button_Click"/>

                        <Button Content="Открыть журнал"
                                Style="{StaticResource GhostButtonStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="0,26,18,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Кадры" Foreground="#8AA0C1" FontSize="12"/>
                        <TextBlock x:Name="Cadr_tbx" Text="0"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource MetricPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Знаки" Foreground="#8AA0C1" FontSize="12"/>
                        <TextBlock Text="27"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MetricPanelStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Сохранено в БД" Foreground="#8AA0C1" FontSize="12"/>
                        <TextBlock Text="4"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource ShellCardStyle}"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Главный просмотр"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Текущий кадр и выбранный лучший снимок найденного знака"
                                   Foreground="#8297B9"
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#070D16"
                            BorderBrush="#1D2A40"
                            BorderThickness="1"
                            CornerRadius="24">
                        <Grid>
                            <Image x:Name="VideoFrameImage"
                                   Stretch="Uniform"
                                   Margin="24"/>

                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="#0B1320"
                            BorderBrush="#1C2A41"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="16"
                            Margin="0,18,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Ход автоматической обработки"
                                           Foreground="#E5EEFC"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="72%"
                                           Foreground="#9DCCFF"
                                           FontWeight="Bold"
                                           FontSize="13"/>
                            </DockPanel>

                            <ProgressBar Height="8"
                                         Margin="0,12,0,0"
                                         Value="72"
                                         Maximum="100"/>

                            <TextBlock Text="Видео разбито на кадры, повторяющиеся кадры объединены в одно размещение знака, лучший снимок и оценки подготовлены автоматически."
                                       Foreground="#7E95B8"
                                       FontSize="12"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="2"
                Margin="0,26,26,26"
                Style="{StaticResource ShellCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Подготовленные записи SignPlacement"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Автоматически сформированные записи для базы данных по найденным размещениям дорожных знаков."
                               Foreground="#879CBD"
                               FontSize="12"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              Margin="0,18,0,14"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SingnSave_StPan">

                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Background="#0D1625"
                        BorderBrush="#20314A"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Статус записи в БД"
                                   Foreground="#E3ECFB"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                        <ProgressBar Height="8"
                                     Margin="0,12,0,0"
                                     Value="66"
                                     Maximum="100"/>
                        <TextBlock Text="4 записи сохранены, 2 записи ожидают завершения автоматической обработки."
                                   Foreground="#849ABD"
                                   FontSize="12"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
