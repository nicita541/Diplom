<Window x:Class="Diplom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Diplom"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="900">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть http видео" Click="MenuItem_open_http_Click"/>
                <MenuItem Header="Открыть MP4 видео" Click="MenuItem_open_mp4_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="MenuItem_exit_Click"/>
            </MenuItem>

            <MenuItem Header="Обработка">
                <MenuItem Header="Запустить" Click="MenuProcessingStart_Click"/>
                <MenuItem Header="Остановить" Click="MenuProcessingStop_Click"/>
            </MenuItem>

            <MenuItem Header="Справка">
                <MenuItem Header="О программе"/>
            </MenuItem>

            <MenuItem Header="БД">
                <MenuItem Header="Путь" Click="MenuItem_Click"/>
            </MenuItem>
        </Menu>

        <ToolBarTray Grid.Row="1">
            <ToolBar>
                <TextBlock Text="URL потока:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Name="TextBoxStreamUrl"
                         Width="350"
                         Text="http://192.168.0.11:8080/stream"
                         Margin="5"/>

                <Button Name="ButtonStart"
                        Content="Старт"
                        Width="80"
                        Margin="5"
                        Click="ButtonVideoStart_Click"/>

                <Button Name="ButtonStop"
                        Content="Стоп"
                        Width="80"
                        Margin="5"
                        Click="ButtonVideoStop_Click"/>

                <TextBlock Name="TextBlockStatus"
                           Text="Нет подключения"
                           Margin="5"
                           VerticalAlignment="Center"
                           Foreground="Red"/>

                <Separator/>

                <TextBlock Text="Очередь:"
                           Margin="10,0,5,0"
                           VerticalAlignment="Center"/>

                <ProgressBar Name="QueueProgressBar"
                             Width="120"
                             Height="16"
                             Minimum="0"
                             Maximum="200"
                             Value="0"
                             Margin="5"
                             VerticalAlignment="Center"/>

                <TextBlock Name="TextBlockQueueStatus"
                           Text="0"
                           Margin="5"
                           VerticalAlignment="Center"
                           FontWeight="Bold"/>

            </ToolBar>
        </ToolBarTray>

        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Исходное видео" Margin="0,0,5,0">
                <Grid>
                    <Image Name="OriginalImage" Stretch="Uniform"/>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Gray"/>

            <GroupBox Grid.Column="2" Header="Видео после обработки" Margin="5,0,0,0">
                <Grid>
                    <Image Name="ProcessedImage" Stretch="Uniform"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>